{
  "name": "screw-cost-calculator",
  "productName": "Screw Cost Calculator",
  "version": "1.7.0",
  "description": "Offline screw manufacturing cost calculator with local SQLite storage",
  "main": "src/main/main.js",
  "author": "shadabalam2024",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadabalam2024/screw-cost-calculator.git"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.shadabalam2024.screwcostcalculator",
    "productName": "Screw Cost Calculator",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shadabalam2024",
        "repo": "screw-cost-calculator"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  }
}
